          {
            "title": "Categories",
            "rows": [
              {
                "id": "svccat-wash",
                "title": "Washing",
                "description": "Foam & premium washing"
              },
              {
                "id": "svccat-interior",
                "title": "Interior Care",
                "description": "Cleaning, steam, leather, detailing"
              },
              {
                "id": "svccat-coating",
                "title": "Coatings & Protection",
                "description": "Sealant, ceramic, corrosion treatment"
              },
              {
                "id": "svccat-glass",
                "title": "Glass & Window Films",
                "description": "Windshield coating, sun control film"
              }
