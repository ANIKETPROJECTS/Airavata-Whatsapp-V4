          {
            "name": "selected_service",
            "operator": "set",
            "value": "{{list_reply}}"
          }
        ]
      }
    },
    {
      "id": "api-price",
      "type": "customApi",
      "position": {
        "x": 700,
        "y": 1730
      },
      "data": {
        "label": "Lookup Price",
        "method": "POST",
        "url": "https://your-backend.example.com/api/pricing/lookup",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_API_KEY"
          }
        ],
        "body": "{\n  \"car_category\": \"{{car_category}}\",\n  \"service\": \"{{selected_service}}\"\n}",
        "responseMapping": [
          {
            "path": "$.price",
            "variable": "service_price"
          },
          {
            "path": "$.description",
            "variable": "service_description"
          }
        ],
        "testResult": null
      }
    },
    {
      "id": "text-details",
      "type": "textReply",
      "position": {
        "x": 700,
        "y": 1880
      },
      "data": {
        "label": "Service Price & Details",
        "message": "*{{selected_service}}*\n\nVehicle: {{car_category}}\nPrice: ₹{{service_price}}\n\n{{service_description}}\n\nWould you like to book this service?",
        "typingDelay": 1
      }
    },
    {
      "id": "cta-book-or-view",
      "type": "ctaButton",
      "position": {
        "x": 700,
        "y": 2030
      },
      "data": {
        "label": "Book or Browse",
        "body": "What would you like to do next?",
        "footer": "Reply with a button below",
        "buttons": [
          {
            "id": "btn-book",
            "title": "📅 Book Appointment"
          },
          {
            "id": "btn-other",
            "title": "🔎 View Other Services"
          }
        ]
      }
    },
    {
      "id": "cond-book",
      "type": "condition",
      "position": {
        "x": 700,
        "y": 2180
      },
      "data": {
        "label": "Check: Book or Browse?",
        "conditions": [
          {
            "field": "button_reply",
            "operator": "contains",
            "value": "Book"
          }
        ],
        "logicType": "AND"
      }
    },
    {
      "id": "q-name",
      "type": "question",
      "position": {
        "x": 400,
        "y": 2340
      },
      "data": {
        "label": "Ask Name",
        "question": "Great choice! Let's book your appointment.\n\nFirst, what's your full name?",
        "variable": "customer_name",
        "inputType": "text",
        "required": true
      }
    },
    {
      "id": "q-phone",
      "type": "question",
      "position": {
        "x": 400,
        "y": 2480
      },
      "data": {
        "label": "Ask Phone",
        "question": "Thanks {{customer_name}}! What's the best mobile number to reach you on?",
        "variable": "phone",
        "inputType": "phone",
        "required": true
      }
    },
    {
      "id": "q-vehicle",
      "type": "question",
      "position": {
        "x": 400,
        "y": 2620
      },
      "data": {
        "label": "Ask Vehicle Model",
