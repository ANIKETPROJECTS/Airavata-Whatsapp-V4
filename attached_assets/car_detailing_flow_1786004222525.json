{
  "name": "Car Detailing WhatsApp Chatbot Flow",
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": {
        "x": 400,
        "y": 40
      },
      "data": {
        "label": "Start",
        "description": "Entry point — triggered when a user first messages the WhatsApp number"
      }
    },
    {
      "id": "keyword-1",
      "type": "keyword",
      "position": {
        "x": 400,
        "y": 180
      },
      "data": {
        "label": "Greeting Trigger",
        "keywords": [
          "hi",
          "hello",
          "hey",
          "interested",
          "details",
          "service",
          "car wash",
          "pricing",
          "start"
        ],
        "matchType": "contains",
        "caseSensitive": false
      }
    },
    {
      "id": "text-welcome",
      "type": "textReply",
      "position": {
        "x": 400,
        "y": 330
      },
      "data": {
        "label": "Welcome Message",
        "message": "Welcome to *{{company.name}}* 🚗✨\n\nWe're happy to help you choose the perfect detailing package.\n\nPlease select your vehicle type below.",
        "typingDelay": 1.5
      }
    },
    {
      "id": "list-vehicle",
      "type": "listReply",
      "position": {
        "x": 400,
        "y": 480
      },
      "data": {
        "label": "Vehicle Category",
        "header": "🚘 Select Vehicle Type",
        "body": "Choose the category that matches your car so we can show accurate pricing.",
        "footer": "Prices vary by vehicle size",
        "buttonText": "Select Vehicle",
        "sections": [
          {
            "title": "Vehicle Types",
            "rows": [
              {
                "id": "cat-small",
                "title": "Small Cars",
                "description": "e.g. Alto, Kwid, Eon"
              },
              {
                "id": "cat-hatch",
                "title": "Hatchback / Small Sedan",
                "description": "e.g. Swift, i20, Amaze"
              },
              {
                "id": "cat-mid",
                "title": "Mid-size Sedan / Compact SUV / MUV",
                "description": "e.g. City, Creta, Ertiga"
              },
              {
                "id": "cat-suv",
                "title": "SUV / MPV",
                "description": "e.g. Fortuner, XUV700, Innova"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "attr-category",
      "type": "attribute",
      "position": {
        "x": 400,
        "y": 650
      },
      "data": {
        "label": "Save Vehicle Category",
        "attributes": [
          {
            "name": "car_category",
            "operator": "set",
            "value": "{{list_reply}}"
          }
        ]
      }
    },
    {
      "id": "list-service-category",
      "type": "listReply",
      "position": {
        "x": 400,
        "y": 800
