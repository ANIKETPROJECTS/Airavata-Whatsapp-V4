            "id": "btn-confirm",
            "title": "✅ Confirm Booking"
          },
          {
            "id": "btn-edit",
            "title": "✏️ Edit Booking"
          }
        ]
      }
    },
    {
      "id": "cond-confirm",
      "type": "condition",
      "position": {
        "x": 400,
        "y": 3650
      },
      "data": {
        "label": "Check: Confirm or Edit?",
        "conditions": [
          {
            "field": "button_reply",
