      "position": {
        "x": 250,
        "y": 3800
      },
      "data": {
        "label": "Tag Booking",
        "action": "add",
        "tags": [
          "car-detailing",
          "booking-confirmed",
          "bot-handled"
        ]
      }
    },
    {
      "id": "api-crm",
      "type": "customApi",
      "position": {
        "x": 250,
        "y": 3950
      },
      "data": {
        "label": "Send Booking to CRM/Sheet",
        "method": "POST",
        "url": "https://webhook.site/your-unique-url",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_API_KEY"
          }
        ],
        "body": "{\n  \"customer_name\": \"{{customer_name}}\",\n  \"phone\": \"{{phone}}\",\n  \"vehicle_category\": \"{{car_category}}\",\n  \"vehicle_model\": \"{{vehicle_model}}\",\n  \"selected_service\": \"{{selected_service}}\",\n  \"price\": \"{{service_price}}\",\n  \"appointment_date\": \"{{appointment_date}}\",\n  \"appointment_time\": \"{{appointment_time}}\",\n  \"notes\": \"{{notes}}\",\n  \"timestamp\": \"{{timestamp}}\",\n  \"source\": \"whatsapp-bot\"\n}",
        "responseMapping": [
          {
            "path": "$.booking_id",
            "variable": "booking_id"
          }
        ],
        "testResult": null
      }
    },
    {
      "id": "text-final",
      "type": "textReply",
      "position": {
        "x": 250,
        "y": 4100
      },
      "data": {
        "label": "Booking Confirmation",
        "message": "Thank you for choosing *{{company.name}}* 🚗✨\n\nYour appointment has been successfully booked!\n\n🎫 Booking ID: {{booking_id}}\n\nOur team will contact you shortly to confirm. We look forward to serving you!",
        "typingDelay": 1
      }
    },
    {
      "id": "assign-1",
      "type": "assignAgent",
      "position": {
        "x": 250,
        "y": 4250
      },
      "data": {
        "label": "Assign to Detailing Team",
        "assignType": "team",
        "agentId": "",
        "teamId": "detailing-team",
        "priority": "normal",
        "note": "New appointment booked via WhatsApp bot. Awaiting confirmation call."
      }
    },
    {
      "id": "error-1",
      "type": "errorHandler",
      "position": {
        "x": 900,
        "y": 4000
      },
      "data": {
        "label": "Error Fallback",
