      "position": {
        "x": 400,
        "y": 3200
      },
      "data": {
        "label": "Ask Additional Notes",
        "question": "Any additional notes for our team? (Optional — reply 'skip' if none)",
        "variable": "notes",
        "inputType": "text",
        "required": false
      }
    },
    {
      "id": "text-summary",
      "type": "textReply",
      "position": {
        "x": 400,
        "y": 3350
